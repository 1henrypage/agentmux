#!/usr/bin/env python3
"""agentmux sidebar launcher. The process name must contain "agentmux-sidebar" so
tmux-resurrect's `@resurrect-processes '~agentmux-sidebar'` restores it."""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from agentmux.sidebar import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
